# AI Model API Keys
# Replace with your actual API keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GLM_API_KEY=your_glm_api_key_here
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-google-api-key
GROQ_API_KEY=gsk-your-groq-key
MISTRAL_API_KEY=your-mistral-key

# Web Search (Ollama Cloud - FREE)
# Get your free API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key-here

# Search API Keys (Alternative providers)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434/api

# ComfyUI (for MiniMax H3 Director dashboard)
COMFYUI_URL=http://127.0.0.1:8188

# VocalLab (TTS for avatar lip-sync)
VOCALLAB_API_KEY=your_vocallab_api_key_here

# ---------------------------------------------------------------------------
# Render providers — EVERY provider is optional (see docs/IMAGE-FIRST-PIPELINE.md)
# ---------------------------------------------------------------------------
# This project is open source and each user has their own toolbox. No provider is
# assumed to exist: the Director probes each one at call time and uses whatever is
# actually available on THIS machine. Check yours at GET /api/providers.
#
# Preference order, comma-separated (first available wins). Omit for the default.
# Default: vois-cli,vocallab  — local & unlimited first, metered APIs after.
# RENDER_PROVIDER_ORDER=vois-cli,vocallab
#
# Force a provider off even when it is available.
# RENDER_PROVIDERS_DISABLED=vocallab
#
# Vois (local voice studio). The CLI ships inside the desktop app installer.
# The app must be RUNNING — the CLI is an IPC client, not a server.
# VOIS_CLI=C:\Users\<you>\AppData\Local\Vois\vois-cli.exe
# VOIS_ENGINE=standard        # fast | standard | multilingual | omni (Pro)
# VOIS_VOICE=narrators_ai_voices/morgan_vale
# VOIS_LANGUAGE=English

# Database
DATABASE_PATH=./data/assistant.db

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ONLYOFFICE Document Server
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080
# Use host.docker.internal for Docker Desktop (Mac/Windows), or your real domain in production
NEXT_PUBLIC_DASHBOARD_URL=http://host.docker.internal:3000
# JWT secret MUST match the Docker container's JWT_SECRET
ONLYOFFICE_JWT_SECRET=your-super-secret-32-char-key-here
JWT_ENABLED=true

# Authentication (optional - disabled by default)
# Set to 'true' to enable authentication for production/multi-user deployments
ENABLE_AUTH=false
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=user123
